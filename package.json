{
    "name": "myde",
    "version": "26.10.26-alpha",
    "description": "my desktop",
    "main": "./out/main/main.js",
    "scripts": {
        "pack": "pnpm build && electron-builder --dir -c electron-builder.config.js",
        "dist": "pnpm build && electron-builder -p never -c electron-builder.config.js",
        "dev": "pnpm build:packages && pnpm build:desktop && electron-vite --ignoreConfigWarning dev",
        "build": "pnpm build:packages && pnpm build:desktop && electron-vite --ignoreConfigWarning build",
        "build:packages": "pnpm -r --filter \"./packages/*\" run build",
        "build:desktop": "cd desktop/official && npm run build",
        "build:test-apps": "cargo build --manifest-path test/simple_app/Cargo.toml",
        "build:myde-wrap": "bash script/myde_wrap/build.sh",
        "input:access": "bash script/input_access.sh",
        "build:remote-connect": "cd src/remote_connect && pnpm build",
        "typecheck": "pnpm -r --filter \"./packages/*\" run build:ts && pnpm -r --filter \"./packages/*\" run typecheck && tsc --noEmit -p tsconfig.typecheck.json",
        "test": "vitest run",
        "test:host-services": "MYDE_TEST_HOST_SERVICES=1 vitest run src/sys_api/test",
        "test:smoothness": "vitest run desktop/official/test/smoothness.test.ts",
        "test:window-open": "vitest run desktop/official/test/window_open.test.ts",
        "biome": "biome check .",
        "biome:fix": "biome check --write .",
        "biome:format": "biome format --write .",
        "wayland:gen-protocols": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON script/wayland/gen_protocols.ts",
        "desktop:simpletest": "export desktop=':test' && electron-vite --ignoreConfigWarning preview",
        "desktop:official": "pnpm build:desktop && export desktop='desktop/official' && electron-vite --ignoreConfigWarning preview",
        "desktop:remote": "cd desktop/remote && npm run build && cd ../.. && export desktop='desktop/remote' && electron-vite --ignoreConfigWarning preview",
        "desktop:example": "cd desktop/example && npm run build && cd ../.. && export desktop='desktop/example' && electron-vite --ignoreConfigWarning preview",
        "test:frametime": "vite desktop/official/test/frametime",
        "test:file-chooser": "vite desktop/official/test/file_chooser",
        "test:polkit-dialog": "vite desktop/official/test/polkit_dialog"
    },
    "author": {
        "name": "xsf",
        "email": "xushengfeng_zg@163.com"
    },
    "homepage": "https://github.com/xushengfeng/myde/",
    "license": "AGPL-3.0-only",
    "dependencies": {
        "dkh-ui": "^0.14.6",
        "ini": "^5.0.0",
        "myde-dbus": "^0.4.0",
        "myde-drm": "workspace:*",
        "myde-input": "workspace:*",
        "msgpackr": "^1.11.0",
        "myde-pam-client": "^0.1.3",
        "myde-remote-connect": "^0.0.5",
        "myde-ui": "0.0.7",
        "myde-unix-socket": "^0.2.7",
        "myde-xcb": "^0.1.1",
        "peerjs": "^1.5.5",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
        "@types/ini": "^4.1.1",
        "@types/node": "^24.12.0",
        "@types/xml2js": "^0.4.14",
        "electron": "^45.0.0",
        "electron-builder": "^24.4.0",
        "electron-vite": "^4.0.1",
        "typescript": "^6.0.2",
        "vite": "^7.1.7",
        "vitest": "^4.1.0"
    }
}
