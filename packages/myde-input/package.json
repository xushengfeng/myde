{
  "name": "myde-input",
  "version": "1.0.5",
  "description": "High-performance Linux input device reader",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml && node script/copy-bin.mjs",
    "build:ts": "vite build",
    "build": "pnpm build:rust && pnpm build:ts",
    "dev": "vite",
    "cli": "tsx cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "linux",
    "input",
    "evdev",
    "keyboard",
    "mouse",
    "touchscreen"
  ],
  "author": "xsf",
  "repository": {
    "type": "git",
    "url": "https://github.com/xushengfeng/myde.git",
    "directory": "packages/myde-input"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "msgpackr": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
